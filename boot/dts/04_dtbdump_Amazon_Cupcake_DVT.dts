	thermal-zones {

		skin_virtual {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			policy = "step_wise";
			thermal-sensors = <0x53>;

			trips {

				trip-point@0 {
					temperature = <0xdac0>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x54>;
					phandle = <0x54>;
				};

				trip-point@1 {
					temperature = <0xdea8>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x55>;
					phandle = <0x55>;
				};

				trip-point@2 {
					temperature = <0xe290>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x56>;
					phandle = <0x56>;
				};

				trip-point@3 {
					temperature = <0xe678>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x57>;
					phandle = <0x57>;
				};

				trip-point@4 {
					temperature = <0xea60>;
					hysteresis = <0x1f4>;
					type = "critical";
				};
			};

			cooling-maps {

				cpufreq_cooling_map0 {
					trip = <0x54>;
					cooling-device = <0x0a 0x00 0x00>;
					contribution = <0x400>;
				};

				cpufreq_cooling_map1 {
					trip = <0x55>;
					cooling-device = <0x0a 0x00 0x01>;
					contribution = <0x400>;
				};

				cpufreq_cooling_map2 {
					trip = <0x56>;
					cooling-device = <0x0a 0x01 0x02>;
					contribution = <0x400>;
				};

				cpufreq_cooling_map3 {
					trip = <0x57>;
					cooling-device = <0x0a 0x02 0x03>;
					contribution = <0x400>;
				};
			};
		};

		case_virtual {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			policy = "step_wise";
			thermal-sensors = <0x58>;

			trips {

				trip-point@0 {
					temperature = <0xdac0>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x59>;
					phandle = <0x59>;
				};

				trip-point@1 {
					temperature = <0xdea8>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x5a>;
					phandle = <0x5a>;
				};

				trip-point@2 {
					temperature = <0xe290>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x5b>;
					phandle = <0x5b>;
				};

				trip-point@3 {
					temperature = <0xe678>;
					hysteresis = <0x1f4>;
					type = "passive";
					linux,phandle = <0x5c>;
					phandle = <0x5c>;
				};

				trip-point@4 {
					temperature = <0xea60>;
					hysteresis = <0x1f4>;
					type = "critical";
				};
			};

			cooling-maps {

				cpufreq_cooling_map0 {
					trip = <0x59>;
					cooling-device = <0x0a 0x00 0x00>;
					contribution = <0x400>;
				};

				cpufreq_cooling_map1 {
					trip = <0x5a>;
					cooling-device = <0x0a 0x00 0x01>;
					contribution = <0x400>;
				};

				cpufreq_cooling_map2 {
					trip = <0x5b>;
					cooling-device = <0x0a 0x01 0x02>;
					contribution = <0x400>;
				};

				cpufreq_cooling_map3 {
					trip = <0x5c>;
					cooling-device = <0x0a 0x02 0x03>;
					contribution = <0x400>;
				};
			};
		};

		wifi_temp {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			policy = "step_wise";
			thermal-sensors = <0x51>;
		};

		therm0_s {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			policy = "step_wise";
