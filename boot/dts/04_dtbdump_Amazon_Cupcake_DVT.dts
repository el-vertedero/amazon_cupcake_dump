/dts-v1/;

/ {
	model = "Amazon Cupcake DVT";
	compatible = "amzn,cupcake-pvt\0amzn,cupcake-dvt\0amzn,cupcake";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	atf_logger {
		compatible = "mediatek,atf_logger";
		interrupts = <0x00 0xdd 0x01>;
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		linux,phandle = <0x08>;
		phandle = <0x08>;

		opp00 {
			opp-hz = <0x00 0x23a4c180>;
			opp-microvolt = <0x118c30>;
		};

		opp01 {
			opp-hz = <0x00 0x2c8df1e0>;
			opp-microvolt = <0x118c30>;
		};

		opp02 {
			opp-hz = <0x00 0x3dfd2400>;
			opp-microvolt = <0x124f80>;
		};

		opp03 {
			opp-hz = <0x00 0x47498300>;
			opp-microvolt = <0x1312d0>;
		};

		opp04 {
			opp-hz = <0x00 0x4d7c6d00>;
			opp-microvolt = <0x13d620>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			next-level-cache = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			clocks = <0x05 0x00 0x06 0x08 0x07 0x00>;
			clock-names = "cpu\0intermediate\0armpll";
			operating-points-v2 = <0x08>;
			clock-frequency = "M|m";
			#cooling-cells = <0x02>;
			proc-supply = <0x09>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			next-level-cache = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			clocks = <0x05 0x00 0x06 0x08 0x07 0x00>;
			clock-names = "cpu\0intermediate\0armpll";
			operating-points-v2 = <0x08>;
			clock-frequency = "M|m";
			proc-supply = <0x09>;
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			next-level-cache = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			clocks = <0x05 0x00 0x06 0x08 0x07 0x00>;
			clock-names = "cpu\0intermediate\0armpll";
			operating-points-v2 = <0x08>;
			clock-frequency = "M|m";
			proc-supply = <0x09>;
			linux,phandle = <0x0c>;
			phandle = <0x0c>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			next-level-cache = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x03 0x04 0x04 0x04>;
			clocks = <0x05 0x00 0x06 0x08 0x07 0x00>;
			clock-names = "cpu\0intermediate\0armpll";
			operating-points-v2 = <0x08>;
			clock-frequency = "M|m";
			proc-supply = <0x09>;
			linux,phandle = <0x0d>;
			phandle = <0x0d>;
		};

		l2-cache0 {
			compatible = "cache";
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x4b0>;
				linux,phandle = <0x04>;
				phandle = <0x04>;
			};

			cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010000>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x3e8>;
				min-residency-us = <0x7d0>;
				linux,phandle = <0x03>;
				phandle = <0x03>;
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		atf-reserved-memory@43000000 {
			compatible = "mediatek,mt8167-atf-reserved-memory";
			no-map;
			reg = <0x00 0x43000000 0x00 0x30000>;
		};

		ram_console-reserved-memory@44400000 {
			compatible = "mediatek,ram_console";
			reg = <0x00 0x44400000 0x00 0x10000>;
		};

		pstore-reserved-memory@44410000 {
			compatible = "mediatek,pstore";
			reg = <0x00 0x44410000 0x00 0xe0000>;
		};

		minirdump-reserved-memory@444f0000 {
			compatible = "mediatek,minirdump";
			reg = <0x00 0x444f0000 0x00 0x10000>;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x00 0x200000>;
			alignment = <0x00 0x200000>;
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0x04 0x08 0x00 0x05 0x08 0x00 0x06 0x08 0x00 0x07 0x08>;
		interrupt-affinity = <0x0a 0x0b 0x0c 0x0d>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	clocks {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			linux,phandle = <0x0f>;
			phandle = <0x0f>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x0e>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0xc65d40>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		chipid@08000000 {
			compatible = "mediatek,chipid";
			reg = <0x00 0x8000000 0x00 0x04 0x00 0x8000004 0x00 0x04 0x00 0x8000008 0x00 0x04 0x00 0x800000c 0x00 0x04>;
		};

		topckgen@10000000 {
			compatible = "mediatek,mt8167-topckgen\0syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			linux,phandle = <0x06>;
			phandle = <0x06>;
		};

		infracfg@10001000 {
			compatible = "mediatek,mt8167-infracfg\0syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <0x01>;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		btcvsd@10001000 {
			compatible = "mediatek,audio_bt_cvsd";
			offset = <0xc00 0x02 0xfd0 0xfd4 0xfd8>;
			reg = <0x00 0x10001000 0x00 0x1000 0x00 0x18000000 0x00 0x10000 0x00 0x18080000 0x00 0x8000>;
			interrupts = <0x00 0xc2 0x08>;
			status = "okay";
		};

		mt_soc_btcvsd_rx_pcm@10001000 {
			compatible = "mediatek,mt_soc_btcvsd_rx_pcm";
			status = "okay";
		};

		mt_soc_btcvsd_tx_pcm@10001000 {
			compatible = "mediatek,mt_soc_btcvsd_tx_pcm";
			status = "okay";
		};

		syscfg_pctl_a@10005000 {
			compatible = "mediatek,mt8167-pctl-a-syscfg\0syscon";
			reg = <0x00 0x10005000 0x00 0x1000>;
			linux,phandle = <0x10>;
			phandle = <0x10>;
		};

		toprgu@10007000 {
			compatible = "mediatek,mt8167-wdt\0mediatek,mt6589-wdt";
			reg = <0x00 0x10007000 0x00 0x1000>;
			interrupts = <0x00 0xc6 0x02>;
			#reset-cells = <0x01>;
			linux,phandle = <0x3b>;
			phandle = <0x3b>;
		};

		timer@10008000 {
			compatible = "mediatek,mt8167-timer\0mediatek,mt6577-timer";
			reg = <0x00 0x10008000 0x00 0x1000>;
			interrupts = <0x00 0x84 0x08>;
			clocks = <0x06 0x32 0x0f 0x06 0x5a>;
			clock-names = "clk13m\0clk32k\0bus";
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt8167-pinctrl";
			reg = <0x00 0x1000b000 0x00 0x1000>;
			mediatek,pctl-regmap = <0x10>;
			pins-are-numbered;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x86 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x11>;
			linux,phandle = <0x14>;
			phandle = <0x14>;

			uart0_pin_uart_mode {
				linux,phandle = <0x1c>;
				phandle = <0x1c>;

				pins_rx {
					pinmux = <0x3e01>;
					bias-pull-up;
				};

				pins_tx {
					pinmux = <0x3f01>;
					output-high;
				};
			};

			uart0_pin_gpio_mode {

				pins_rx {
					pinmux = <0x3e00>;
					bias-pull-down;
				};

				pins_tx {
					pinmux = <0x3f00>;
					output-low;
				};
			};

			uart1_pin_uart_mode {
				linux,phandle = <0x1d>;
				phandle = <0x1d>;

				pins_rx {
					pinmux = <0x4001>;
					bias-pull-up;
				};

				pins_tx {
					pinmux = <0x4101>;
					output-high;
				};
			};

			uart1_pin_gpio_mode {
				linux,phandle = <0x1e>;
				phandle = <0x1e>;

				pins_rx {
					pinmux = <0x4000>;
					bias-pull-down;
				};

				pins_tx {
					pinmux = <0x4100>;
					output-low;
				};
			};

			uart2_pin_uart_mode {
				linux,phandle = <0x1f>;
				phandle = <0x1f>;

				pins_rx {
					pinmux = <0x2201>;
					bias-pull-up;
				};

				pins_tx {
					pinmux = <0x2301>;
					output-high;
				};

				pins_cts {
					pinmux = <0x1804>;
				};

				pins_rts {
					pinmux = <0x1904>;
				};
			};

			uart2_pin_gpio_mode {
				linux,phandle = <0x20>;
				phandle = <0x20>;

				pins_rx {
					pinmux = <0x2200>;
					bias-pull-down;
				};

				pins_tx {
					pinmux = <0x2300>;
					output-low;
				};

				pins_cts {
					pinmux = <0x1800>;
				};

				pins_rts {
					pinmux = <0x1900>;
				};
			};

			pinconf_default {
				linux,phandle = <0x11>;
				phandle = <0x11>;
			};

			eint4default {
				linux,phandle = <0x15>;
				phandle = <0x15>;
			};

			eint4 {
				linux,phandle = <0x16>;
				phandle = <0x16>;

				pins_cmd_dat {
					pins = <0x1700>;
					bias-disable;
				};
			};

			pwmdefault {
				linux,phandle = <0x21>;
				phandle = <0x21>;

				pins_cmd_dat {
					pinmux = <0x3602>;
				};
			};

			audiodefault {
				linux,phandle = <0x41>;
				phandle = <0x41>;

				pins_cmd_dat {
					pinmux = <0x6505 0x6605 0x6705 0x2403 0x2503 0x2603 0x1403>;
					drive-strength = <0x04>;
				};
			};

			gpiodefault {
				linux,phandle = <0x3f>;
				phandle = <0x3f>;

				pins_cmd_dat {
					pinmux = <0x700 0xc00>;
					slew-rate = <0x00>;
					bias-pull-up = <0x65>;
					input-enable;
				};
			};

			default {
			};

			ethernet {
				linux,phandle = <0x3e>;
				phandle = <0x3e>;

				pins_ethernet {
					pinmux = <0x04 0x104 0x204 0x304 0x404 0x504 0x604 0x704 0x804 0x904 0xa04 0xb06 0xc06 0x2706>;
				};
			};

			irrx_pin_ir {
				linux,phandle = <0x13>;
				phandle = <0x13>;

				pins_cmd_dat {
					pinmux = <0x2406>;
					bias-disable;
				};
			};

			hdmi_pins_default {
				linux,phandle = <0x36>;
				phandle = <0x36>;

				pins_cmd_dat {
					pins = <0x7b01 0x7c01>;
				};
			};

			hdmi_pins_hpd {
				linux,phandle = <0x37>;
				phandle = <0x37>;

				pins_cmd_dat {
					pins = <0x7a01>;
					slew-rate = <0x00>;
					bias-pull-down;
				};
			};

			i2c0@0 {
				linux,phandle = <0x22>;
				phandle = <0x22>;

				pins1 {
					pinmux = <0x3a01 0x3b01>;
					bias-disable;
				};
			};

			i2c1@0 {
				linux,phandle = <0x23>;
				phandle = <0x23>;

				pins1 {
					pinmux = <0x3401 0x3501>;
					bias-disable;
				};
			};

			i2c2@0 {
				linux,phandle = <0x24>;
				phandle = <0x24>;

				pins1 {
					pinmux = <0x3c01 0x3d01>;
					bias-disable;
				};
			};

			mmc0default {
				linux,phandle = <0x28>;
				phandle = <0x28>;

				pins_cmd_dat {
					pinmux = <0x7801 0x7701 0x7601 0x7501 0x7101 0x7001 0x6f01 0x6e01 0x7301>;
					input-enable;
					bias-pull-up;
				};

				pins_clk {
					pinmux = <0x7401>;
					bias-pull-down;
				};

				pins_rst {
					pinmux = <0x7201>;
					bias-pull-up;
				};
			};

			mmc0@0 {
				linux,phandle = <0x29>;
				phandle = <0x29>;

				pins_cmd_dat {
					pinmux = <0x7801 0x7701 0x7601 0x7501 0x7101 0x7001 0x6f01 0x6e01 0x7301>;
					input-enable;
					drive-strength = <0x06>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x7401>;
					drive-strength = <0x08>;
					bias-pull-down = <0x66>;
				};

				pins_rst {
					pinmux = <0x7201>;
					bias-pull-up;
				};
			};

			mmc1default {
				linux,phandle = <0x2c>;
				phandle = <0x2c>;

				pins_cmd_dat {
					pinmux = <0x6a01 0x6b01 0x6c01 0x6d01 0x6801>;
					input-enable;
					drive-strength = <0x06>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x6901>;
					drive-strength = <0x06>;
					bias-pull-down = <0x66>;
				};
			};

			mmc1@0 {
				linux,phandle = <0x2d>;
				phandle = <0x2d>;

				pins_cmd_dat {
					pinmux = <0x6a01 0x6b01 0x6c01 0x6d01 0x6801>;
					input-enable;
					drive-strength = <0x06>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x6901>;
					drive-strength = <0x08>;
					bias-pull-down = <0x66>;
				};
			};

			mmc1_dat1 {
				linux,phandle = <0x2e>;
				phandle = <0x2e>;

				pins_dat1 {
					pinmux = <0x6b01>;
					input-enable;
					drive-strength = <0x06>;
					bias-pull-up = <0x65>;
				};
			};

			sdio_dat1_eint {
				linux,phandle = <0x2f>;
				phandle = <0x2f>;

				pins_dat1_eint {
					pinmux = <0x6b00>;
					input-enable;
					bias-pull-up = <0x66>;
				};
			};

			mmc2default {
				linux,phandle = <0x31>;
				phandle = <0x31>;

				pins_cmd_dat {
					pinmux = <0x4801 0x4901 0x4401>;
					input-enable;
					drive-strength = <0x08>;
					bias-pull-up = <0x66>;
				};

				pins_clk {
					pinmux = <0x4501>;
					drive-strength = <0x08>;
					bias-pull-down = <0x66>;
				};
			};

			mmc2@0 {
				linux,phandle = <0x32>;
				phandle = <0x32>;

				pins_cmd_dat {
					pinmux = <0x4801 0x4901 0x4401>;
					input-enable;
					drive-strength = <0x08>;
					bias-pull-up = <0x66>;
				};

				pins_clk {
					pinmux = <0x4501>;
					drive-strength = <0x08>;
					bias-pull-down = <0x66>;
				};
			};

			mmc2_dat1 {
				linux,phandle = <0x33>;
				phandle = <0x33>;

				pins_dat1 {
					pinmux = <0x4701>;
					input-enable;
					drive-strength = <0x08>;
					bias-pull-up = <0x66>;
				};
			};

			dat1_eint {
				linux,phandle = <0x34>;
				phandle = <0x34>;

				pins_dat1_eint {
					pinmux = <0x4700>;
					input-enable;
					bias-pull-up = <0x66>;
				};
			};

			cfg_pmu_en_pull_dis {
				linux,phandle = <0x42>;
				phandle = <0x42>;

				combo_pins {
					pins = <0x3000>;
					bias-disable;
				};
			};

			cfg_pmu_en_in_pulldown {
				linux,phandle = <0x43>;
				phandle = <0x43>;

				combo_pins {
					pins = <0x3000>;
					bias-pull-down;
				};
			};

			cfg_rst_pull_dis {
				linux,phandle = <0x44>;
				phandle = <0x44>;

				combo_pins {
					pins = <0x1200>;
					bias-disable;
				};
			};

			cfg_wifi_eint_in_pull_dis {
				linux,phandle = <0x45>;
				phandle = <0x45>;

				combo_pins {
					pins = <0xb00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			cfg_wifi_eint_in_pullup {
				linux,phandle = <0x46>;
				phandle = <0x46>;

				combo_pins {
					pins = <0xb00>;
					slew-rate = <0x00>;
					bias-pull-up = <0x00>;
				};
			};

			cfg_gps_lna_pull_dis {
				linux,phandle = <0x47>;
				phandle = <0x47>;

				combo_pins {
					pins = <0x300>;
					bias-disable;
				};
			};

			cfg_gps_sync_pull_dis {
				linux,phandle = <0x48>;
				phandle = <0x48>;

				combo_pins {
					pins = <0x400>;
					bias-disable;
				};
			};

			cfg_urxd_pull_dis {
				linux,phandle = <0x49>;
				phandle = <0x49>;

				combo_pins {
					pinmux = <0x4001>;
					bias-disable;
				};
			};

			cfg_urxd_out_low {
				linux,phandle = <0x4b>;
				phandle = <0x4b>;

				combo_pins {
					pinmux = <0x4000>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cfg_urxd_in_pullup {
				linux,phandle = <0x4a>;
				phandle = <0x4a>;

				combo_pins {
					pinmux = <0x4001>;
					input-enable;
					bias-pull-up;
				};
			};

			cfg_urxd_in_pull_dis {
				linux,phandle = <0x4c>;
				phandle = <0x4c>;

				combo_pins {
					pinmux = <0x4001>;
					input-enable;
					bias-disable;
				};
			};

			cfg_utxd_pull_dis {
				linux,phandle = <0x4d>;
				phandle = <0x4d>;

				combo_pins {
					pinmux = <0x4101>;
					bias-disable;
				};
			};

			iddig_irq_init {
				linux,phandle = <0x27>;
				phandle = <0x27>;

