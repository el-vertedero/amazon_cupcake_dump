{
  "acoustic-model": {
    "non-speech-pdf": 0,
    "speech-pdf": 0
  },
  "keyword-orchestra": {
    "buffer-size": 200
  },
  "keyword-orchestra-monitor": {
    "statistics": {
     "classification": {
        "histogram": {
          "max": 1.0,
          "min": 0.0,
          "size": 50
        }
      },
     "segmentation": {
        "histogram": {
          "max": 1.0,
          "min": 0.0,
          "size": 1
        }
      }
    }
  },
  "restart-trigger": {
     "max-event-count": 30,
     "evaluation-span-msec": 180000
  },
  "object_type_name": "keyword-spotter-orchestra-config",
  "object_type_version": 2,
  "word-symbol-table": {
    "filename": "words.shrunk.txt"
  }
}
