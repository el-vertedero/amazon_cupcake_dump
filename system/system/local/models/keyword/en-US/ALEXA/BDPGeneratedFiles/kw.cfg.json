{
  "acoustic-model": {
    "non-speech-pdf": 0,
    "speech-pdf": 0
  },
  "keyword-orchestra": {
    "buffer-size": 200,
    "keyword-spotters": [
      {
        "classifier": {
          "type": "exponential-decay",
          "decay-rate": 0.6
        },
        "name": "STOP",
        "scorers": [
          "ww_stop"
        ],
        "spotter": {
          "classification-thresholds": {
            "accept-threshold": 0.6
          },
          "word-component-array": [
            {
              "scorer-index": 1,
              "scorer-output-component": {
                "name": "mww/posteriors",
                "posterior-type": "decoding-scores"
              },
              "keyword-start-scorer-index": 0,
              "keyword-end-scorer-index": 1,
              "keyword-start-end-component": {
                "name": "mww/start_end",
                "posterior-type": "time-alignment-scores"
              }
            }
          ],
          "keyword-feature-window-length": 100,
          "lock-period": 100
        }
      },
      {
        "classifier": {
          "type": "weighted-geometric-average-aggregator",
          "weights": [
            1,
            1
          ]
        },
        "name": "HEY_DISNEY",
        "scorers": [
          "ww_stop"
        ],
        "spotter": {
          "classification-thresholds": {
            "accept-threshold": 0.43,
            "notify-threshold": 0.2,
            "overrides": [
              {
                "accept-threshold": 0.43,
                "clientProperties": [
                  {
                    "equals": 1,
                    "name": "AlarmState"
                  }
                ]
              },
              {
                "accept-threshold": 0.43,
                "clientProperties": [
                  {
                    "equals": 1,
                    "name": "AudioPlayerState"
                  }
                ]
              },
              {
                "accept-threshold": 0.43,
                "clientProperties": [
                  {
                    "equals": 1,
                    "name": "audio_playback"
                  }
                ]
              }
            ]
          },
          "word-component-array": [
            {
              "scorer-index": 2,
              "scorer-output-component": {
                "name": "mww/posteriors",
                "posterior-type": "decoding-scores"
              },
              "word-score-history-size": 100,
              "keyword-start-scorer-index": 0,
              "keyword-end-scorer-index": 1,
              "keyword-start-end-component": {
                "name": "mww/start_end",
                "posterior-type": "time-alignment-scores"
              }
            },
            {
              "scorer-index": 3,
              "scorer-output-component": {
                "name": "mww/posteriors",
                "posterior-type": "decoding-scores"
              },
              "word-score-history-size": 1,
              "keyword-start-scorer-index": 0,
              "keyword-end-scorer-index": 1,
              "keyword-start-end-component": {
                "name": "mww/start_end",
                "posterior-type": "time-alignment-scores"
              }
            }
          ],
          "posterior-smoothers": [
            {
              "type": "exponential-decay",
              "decay-rate": 0.0
            },
            {
              "type": "exponential-decay",
              "decay-rate": 0.3
            }
          ],
          "keyword-feature-window-length": 100,
          "lock-period": 100
        }
      },
      {
        "name": "ALEXA",
        "classifier": {
          "type": "moving-average-max-pool",
          "window-size": 1
        },
        "scorers": [
          "ww_alexa"
        ],
        "spotter": {
          "classification-thresholds": {
            "accept-threshold": 0.92,
            "notify-threshold": 0.25,
            "probabilistic-accept-threshold": 0.5,
            "probabilistic-accept-probability": 0.001,
            "overrides": [
              {
                "accept-threshold": 0.65,
                "clientProperties": [
                  {
                    "equals": 1,
                    "name": "AlarmState"
                  }
                ]
              },
              {
                "accept-threshold": 0.84,
                "clientProperties": [
                  {
                    "equals": 1,
                    "name": "AudioPlayerState"
                  }
                ]
              },
              {
                "accept-threshold": 0.84,
                "clientProperties": [
                  {
                    "equals": 1,
                    "name": "audio_playback"
                  }
                ]
              }
            ]
          },
          "word-component-array": [
            {
              "scorer-index": 1,
              "scorer-output-component": {
                "name": "ww_scores",
                "posterior-type": "decoding-scores"
              },
              "keyword-start-scorer-index": 0,
              "keyword-end-scorer-index": 1,
              "keyword-start-end-component": {
                "name": "start_end",
                "posterior-type": "time-alignment-scores"
              }
            }
          ],
          "keyword-feature-window-length": 100,
          "lock-period": 132
        }
      }
    ]
  },
  "keyword-orchestra-monitor": {
    "statistics": {
      "classification": {
        "histogram": {
          "max": 1.0,
          "min": 0.0,
          "size": 50
        }
      },
      "segmentation": {
        "histogram": {
          "max": 1.0,
          "min": 0.0,
          "size": 1
        }
      }
    }
  },
  "restart-trigger": {
    "max-event-count": 30,
    "evaluation-span-msec": 180000
  },
  "object_type_name": "keyword-spotter-orchestra-config",
  "object_type_version": 2,
  "word-symbol-table": {
    "filename": "words.shrunk.txt"
  }
}