{
    "acoustic-model": {
        "non-speech-pdf": 0,
        "speech-pdf": 0
    },
    "keyword-orchestra": {
        "buffer-size": 200,
        "keyword-spotters": [
            {
                "classifier": {
                    "decay-rate": 0.3,
                    "type": "exponential-decay"
                },
                "name": "ALEXA",
                "spotter": {
                    "classification-thresholds": {
                        "accept-threshold": 0.652,
                        "notify-threshold": 0.385,
                        "overrides": [
                            {
                                "accept-threshold": 0.45,
                                "clientProperties": [
                                    {
                                        "equals": 1,
                                        "name": "AlarmState"
                                    }
                                ]
                            },
                            {
                                "accept-threshold": 0.652,
                                "clientProperties": [
                                    {
                                        "equals": 1,
                                        "name": "AudioPlayerState"
                                    }
                                ]
                            },
                            {
                                "accept-threshold": 0.652,
                                "clientProperties": [
                                    {
                                        "equals": 1,
                                        "name": "audio_playback"
                                    }
                                ]
                            }
                        ]
                    },
                    "keyword-feature-window-length": 100,
                    "lock-period": 100,
                    "notify-lock-period": 100,
                    "word-component-array": [
                        {
                            "keyword-end-scorer-index": 1,
                            "keyword-start-end-component": {
                                "name": "start_end",
                                "posterior-type": "time-alignment-scores"
                            },
                            "keyword-start-scorer-index": 0,
                            "scorer-index": 0,
                            "scorer-output-component": {
                                "name": "alexa/posteriors",
                                "posterior-type": "decoding-scores"
                            }
                        }
                    ]
                }
            },
            {
                "classifier": {
                    "decay-rate": 0.8,
                    "type": "exponential-decay"
                },
                "name": "STOP",
                "spotter": {
                    "classification-thresholds": {
                        "accept-threshold": 0.275
                    },
                    "is-local-command": true,
                    "keyword-feature-window-length": 100,
                    "lock-period": 100,
                    "notify-lock-period": 100,
                    "word-component-array": [
                        {
                            "keyword-end-scorer-index": 1,
                            "keyword-start-end-component": {
                                "name": "start_end",
                                "posterior-type": "time-alignment-scores"
                            },
                            "keyword-start-scorer-index": 0,
                            "scorer-index": 0,
                            "scorer-output-component": {
                                "name": "stop/posteriors",
                                "posterior-type": "decoding-scores"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "keyword-orchestra-monitor": {
        "statistics": {
            "classification": {
                "histogram": {
                    "max": 1,
                    "min": 0,
                    "size": 1
                }
            },
            "segmentation": {
                "histogram": {
                    "max": 1,
                    "min": 0,
                    "size": 1
                }
            }
        }
    },
    "object_type_name": "keyword-spotter-orchestra-config",
    "object_type_version": 2,
    "word-symbol-table": {
        "filename": "words.shrunk.txt"
    }
}
